{
    "name": "colin-tso.github.io",
    "private": true,
    "version": "1.0.0",
    "description": "Colin Tso's personal portfolio — a single static page showcasing free, browser-based engineering tools.",
    "scripts": {
        "start": "npx live-server --port=3000",
        "deploy": "gh-pages -d . -s \"{index.html,css/**,img/**,fonts/**,sw.js}\"",
        "lint": "stylelint \"css/**/*.css\"",
        "prefix": "postcss css/**/*.css --no-map --replace"
    },
    "devDependencies": {
        "@stylistic/stylelint-config": "^5.0.0",
        "autoprefixer": "^10.5.4",
        "live-server": "^1.2.2",
        "postcss": "^8.5.26",
        "postcss-cli": "^11.0.1",
        "stylelint": "^17.14.0",
        "stylelint-config-clean-order": "^10.0.0",
        "stylelint-config-standard": "^40.0.0"
    }
}
